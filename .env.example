# Copy to .env (never commit it). Every line is optional: the defaults below are what Lumina uses without it.

# LLM provider: "ollama" (local, private, default) or "groq" (hosted free tier; text leaves the machine)
LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1                 # default per provider: ollama → llama3.1, groq → llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_xxxxxxxxxxxx      # required only when LLM_PROVIDER=groq

# Local Ollama server (LLM when LLM_PROVIDER=ollama, and the Llama Guard safety model)
# OLLAMA_BASE_URL=http://localhost:11434
# SAFETY_GUARD_MODEL=llama-guard3:1b

# Safety layer extras that use the chat LLM (src/lumina/safety/)
# SAFETY_TRANSLATE=1                 # 0 = French and Arabic messages are assessed as written, without translation
# SAFETY_READER=1                    # 0 = no LLM risk reader: indirect risk is missed, more false alarms

# Voice (spoken replies): Kokoro-82M runs locally — `pip install -e ".[voice]"`; first use downloads ~330 MB
# TTS_ENABLED=1
# TTS_DEVICE=cpu                     # "cuda" is faster but competes with the chat model for GPU memory
# TTS_VOICE_FEMALE=af_heart          # other Kokoro voices: af_bella, af_nicole, bf_emma …
# TTS_VOICE_MALE=am_michael          # am_fenrir, am_puck, bm_george …
# TTS_SPEED=0.95

# Accounts and personal memory (stored only on this machine; never committed)
# LUMINA_USER_DB=data/user/lumina.db
# MEMORY_EXTRACTION=1                # 0 = no per-turn CBT notes (saves one background LLM call per turn)
# Journal entries and mood notes are encrypted with a key created on first use next to the database
# (data/user/data.key). Back it up with the database: without it they cannot be read. Or supply the key yourself:
# LUMINA_DATA_KEY_FILE=data/user/data.key
# LUMINA_DATA_KEY=                   # a Fernet key; takes precedence over the file. Never commit a real one.

# Tools (A2, A3): on "act" turns of signed-in people, look up their own journal, feelings, jar and journey, and
# prepare saves (journal, sleep, mood, jar) that are written only when they press Save. Off by default. Pull the tool model first (ollama pull qwen2.5:3b). It runs on the CPU (~1 s per look-up, ~2 GB RAM)
# so the chat model keeps the GPU; qwen2.5:7b is more careful but needs ~5 GB RAM.
# AGENT_TOOLS=0
# AGENT_MODEL=qwen2.5:3b
# AGENT_NUM_GPU=0

# Turn traces: stage timings, safety outcome, reply path; no text, no user or session id (kept 30 days)
# TRACES_ENABLED=1
# LUMINA_TRACE_DB=data/user/traces.db

# Advanced tuning (the defaults are measured choices; see src/lumina/config.py before changing them)
# LLM_BASE_URL=                      # default per provider (Ollama /v1 or the Groq API)
# LLM_TEMPERATURE=0.6
# LLM_MAX_TOKENS=350
# LLM_TIMEOUT_S=60
# SAFETY_GUARD_TIMEOUT_S=8           # an unavailable Llama Guard degrades to the other safety layers
# SAFETY_GUARD_NUM_GPU=0             # 0 = Llama Guard on the CPU so the chat model stays on an 8 GB GPU; -1 = Ollama decides
# NLP_DEVICE=cpu                     # cpu | auto (GPU if available) for the small classifiers
# LUMINA_INDEX_VERSION=v1            # knowledge index under data/index/
