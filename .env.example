# Copy to .env (never commit it)

# LLM provider: "ollama" (local, private, default) or "groq" (hosted free tier; text leaves the machine)
LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1                 # default per provider: ollama → llama3.1, groq → llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_xxxxxxxxxxxx      # required only when LLM_PROVIDER=groq

# Local Ollama server (LLM when LLM_PROVIDER=ollama, and the Llama Guard safety model)
# OLLAMA_BASE_URL=http://localhost:11434
# SAFETY_GUARD_MODEL=llama-guard3:1b

# Voice (spoken replies): Kokoro-82M runs locally — `pip install -e ".[voice]"`; first use downloads ~330 MB
# TTS_ENABLED=1
# TTS_DEVICE=cpu                     # "cuda" is faster but competes with the chat model for GPU memory
# TTS_VOICE_FEMALE=af_heart          # other Kokoro voices: af_bella, af_nicole, bf_emma …
# TTS_VOICE_MALE=am_michael          # am_fenrir, am_puck, bm_george …
# TTS_SPEED=0.95

# Accounts and personal memory (stored only on this machine; never committed)
# LUMINA_USER_DB=data/user/lumina.db
# MEMORY_EXTRACTION=1                # 0 = no per-turn CBT notes (saves one background LLM call per turn)
