# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
agenticenv/
.ipynb_checkpoints/
.cache/

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# ── Data (large / rebuildable / snapshotted with checksums) ───────────────────
# Vector indexes are rebuilt by the ingestion pipeline; the v0 store is kept in
# data/snapshots/v0 with a sha256 manifest.
**/vectorstore/
data/index/
data/snapshots/
data/raw/
data/interim/
data/cache/
# Personal data (accounts, memory): never committed
data/user/
!data/**/MANIFEST*.json
!data/**/manifest*.json

# ── Logs / OS / editors ───────────────────────────────────────────────────────
logs/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Evaluation: downloaded third-party data and caches are rebuilt by the scripts in eval/;
# our own labelled data (data/eval/intent/*.jsonl) is committed.
data/eval/raw/
data/eval/cache/

# Design reference, kept locally only
docs/design/concept-board.html

.claude/
.vite/
